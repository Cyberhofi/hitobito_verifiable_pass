-# Additional status lines registered with VerifiablePass.register_status
- statuses.each do |status|
  .vp-status{class: status[:ok] ? 'vp-status-ok' : 'vp-status-warning'}
    %span.vp-status-icon= status[:ok] ? '✓' : '!'
    = status[:text]
