-# Reached through the core route /passes/verify/:token: redirect to the verifiable pass
-# page so the same rules and the same display apply everywhere.
- url = VerifiablePass::Card.verify_url(@pass.verify_token)
%meta{'http-equiv': 'refresh', content: "0; url=#{url}"}
%p= link_to t('verifiable_pass.title'), url
